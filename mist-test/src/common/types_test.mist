pub void test_integer_type() {
    i32 x = 42;
    assert_eq!(x, 42);
}

pub void test_float_type() {
    f64 x = 3.14;
    assert_eq!(x, 3.14);
}

pub void test_bool_type() {
    bool x = true;
    assert_eq!(x, true);

    bool y = false;
    assert_eq!(y, false);
}

pub void test_string_type() {
    str* s = "hello";
    assert_eq!(s, "hello");
}

pub void test_tuple_type() {
    [i32, str*] t = (42, "answer");
    assert_eq!(t.0, 42);
    assert_eq!(t.1, "answer");
}

pub void test_ref_type() {
    i32 x = 42;
    i32* r = &x;
    assert_eq!(*r, 42);
}

pub void test_mut_ref_type() {
    let mut x = 42;
    i32 mut* r = &mut x;
    *r = 100;
    assert_eq!(x, 100);
}

pub void test_void_type() {}

i32 add(i32 a, i32 b) {
    a + b
}

pub void test_fn_return_type() {
    assert_eq!(add(3, 4), 7);
}

pub void run_tests() {
    test_integer_type();
    test_float_type();
    test_bool_type();
    test_string_type();
    test_tuple_type();
    test_ref_type();
    test_mut_ref_type();
    test_void_type();
    test_fn_return_type();
}
