pub class Animal {
    pub name String;

    constructor() {
        self.name = "Rex".to_string();
    }

    pub fn speak(*self) {
        println!("Unknown");
    }
}

pub class Dog : Animal {
    constructor() {
        unsafe {
            std::ptr::write(&mut self._super, Animal::new());
        }
    }

    pub override fn speak(*self) {
        println!("Woof!");
    }
}

pub fn run_tests() {
    let dawg = Dog::new();

    dawg.speak();
}
