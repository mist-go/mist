pub module class_test;

pub class Animal<T> {
    pub name String;
    pub val T;

    constructor() {
        self.name = "Rex".to_string();
    }

    pub fn String speak(*self) {
        "Unknown".to_string()
    }

    pub fn void test_speak(*self) {
        assert_eq!(self.speak(), "Woof!");
    }

    pub fn void static_method() {}
}

pub class Mammal<T> : Animal<T> {
    constructor() {
        super = Super::new();
    }

    pub fn void args_test(*self, x i32, y *str) {
        assert_eq!(x, 10);
        assert_eq!(y, "hello");
    }
}

pub class Dog : Mammal<i32> {
    constructor() {
        super = Super::new();
    }

    pub override(Animal<i32>) fn String speak(*self) {
        "Woof!".to_string()
    }

    impl std::fmt::Display {
        fn Result<(), std::fmt::Error> fmt(*self, f *mut std::fmt::Formatter<'_>) {
            write!(f, "🐾 {}", self.name)
        }
    }
}

pub fn void run_tests() {
    let dawg = Dog::new();

    dawg.args_test(10, "hello");

    dawg.test_speak();

    assert_eq!(format!("{dawg}"), "🐾 Rex");
}
